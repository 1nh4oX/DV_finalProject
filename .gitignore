# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual Environment
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# 输出结果文件夹 - 必须忽略（防止文件过大）
# Climate模块输出
climate/output/
climate/output/**/*
climate/data/processed/
climate/data/processed/**/*

# Traffic模块输出
traffic/output/
traffic/output/**/*
traffic/data/processed/
traffic/data/processed/**/*

# 其他可能的输出文件夹
output/
outputs/
outputs/**/*
figures/
figures/**/*
reports/
reports/**/*

# 数据文件 - 必须忽略（文件太大，防止仓库过大）
# Climate 模块数据
climate/data/raw/
climate/data/raw/**/*
!climate/data/raw/.gitkeep

# Traffic 模块数据
traffic/data/sample/
traffic/data/sample/**/*
!traffic/data/sample/.gitkeep

# 所有 CSV 数据文件（额外保护，但排除根目录的 CSV 文件，如果有的话）
*.csv
# 允许根目录的 CSV（如果有配置需要）
!/*.csv
# 但排除数据目录
climate/data/**/*.csv
traffic/data/**/*.csv

# 图表文件
*.png
*.jpg
*.jpeg
*.gif
*.pdf
*.html
*.svg

# 临时文件
*.tmp
*.log
*.cache
.DS_Store
test_*.png
test_*.html

# 原始数据（大文件）
original/
*.csv.bak
*.xlsx.bak

# 系统文件
.DS_Store
Thumbs.db

# API Token 和密钥文件 - 必须忽略（保护隐私）
.kaggle/
kaggle.json
*.key
*.token
.env
.env.local
*.secret

# 环境变量文件
.envrc
secrets.yaml
secrets.yml

# API Token 相关（如果项目中有）
**/kaggle.json
**/.kaggle/
**/*_token.txt
**/*_api_key.txt
